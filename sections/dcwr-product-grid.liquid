{% comment %} DCWR product grid — mirrors the website shop grid. {% endcomment %}
{%- liquid
  assign grid_collection = collections[section.settings.collection]
  if grid_collection == blank or grid_collection.products_count == 0
    assign grid_products = collections.all.products
  else
    assign grid_products = grid_collection.products
  endif
-%}

<section class="dcwr-section" id="shop">
  <div class="dcwr-container">
    <div class="dcwr-section__head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="dcwr-label dcwr-section__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="dcwr-section__title">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}
        <p class="dcwr-section__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <div class="dcwr-grid">
      {%- for product in grid_products limit: section.settings.products_to_show -%}
        <article class="dcwr-card">
          <a class="dcwr-card__media" href="{{ product.url }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'dcwr-card__main', alt: product.featured_image.alt | default: product.title }}
              {% if product.images[1] %}
                {{ product.images[1] | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'dcwr-card__hover', alt: product.title }}
              {% endif %}
            {% else %}
              <span class="dcwr-card__placeholder dcwr-label">Photo coming soon</span>
            {% endif %}
          </a>

          <div class="dcwr-card__body">
            <div style="min-width:0;">
              <h3 class="dcwr-card__title"><a class="dcwr-rule" href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="dcwr-card__desc">{{ product.description | strip_html | truncate: 130 }}</p>
            </div>
            <p class="dcwr-card__price">{{ product.price | money }}</p>
          </div>

          {% if product.available %}
            <a class="dcwr-button dcwr-button--outline dcwr-card__cta" href="{{ product.url }}">Choose size</a>
          {% else %}
            <span class="dcwr-button dcwr-button--disabled dcwr-card__cta">Sold out</span>
          {% endif %}
        </article>
      {%- else -%}
        <p class="dcwr-muted">No products found</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DCWR product grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (empty = all products)" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New in the shop" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Hand-drawn prints on heavyweight cotton tees. Sizes XS to XXL, secure checkout via Shopify." }
  ],
  "presets": [{ "name": "DCWR product grid" }]
}
{% endschema %}
