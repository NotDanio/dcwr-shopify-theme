{% comment %}
  DCWR product grid — generated by the DCWR website.
{% endcomment %}
{{ 'dcwr-theme.css' | asset_url | stylesheet_tag }}

{%- assign grid_collection = collections[section.settings.collection] -%}

<section class="dcwr-grid-section">
  <div class="dcwr-container">
    <div class="dcwr-grid-section__head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="dcwr-label">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="dcwr-grid-section__title">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_label != blank %}
        <a class="dcwr-label" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>

    <div class="dcwr-grid">
      {%- for product in grid_collection.products limit: section.settings.products_to_show -%}
        <a class="dcwr-card" href="{{ product.url }}">
          <div class="dcwr-card__media">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
            {% endif %}
            {% if product.images[1] %}
              {{ product.images[1] | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'dcwr-card__hover', alt: product.title }}
            {% endif %}
            {% unless product.available %}
              <span class="dcwr-card__soldout dcwr-label">Sold out</span>
            {% endunless %}
          </div>
          <div class="dcwr-card__body">
            <h3 class="dcwr-card__title">{{ product.title }}</h3>
            <span class="dcwr-card__price">{{ product.price | money }}</span>
          </div>
        </a>
      {%- else -%}
        <p class="dcwr-card__price">No products in this collection yet.</p>
      {%- endfor -%}
    </div>
  </div>
</section

{% schema %}
{
  "name": "DCWR product grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "T-shirts" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [{{ "name": "DCWR product grid" }}]
}
{% endschema %}
