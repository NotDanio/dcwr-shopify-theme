{% comment %} DCWR product page — mirrors the website product page. {% endcomment %}
<section class="dcwr-product">
  <div class="dcwr-container dcwr-product__layout">
    <div>
      <div class="dcwr-gallery__main" data-dcwr-gallery-main>
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: product.featured_image.alt | default: product.title }}
        {% else %}
          <span class="dcwr-card__placeholder dcwr-label">Photo coming soon</span>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="dcwr-gallery__thumbs">
          {%- for image in product.images limit: 8 -%}
            <button type="button" class="dcwr-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-dcwr-thumb data-full="{{ image | image_url: width: 1400 }}" aria-label="Show image {{ forloop.index }}">
              {{ image | image_url: width: 300 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
      {% endif %}
    </div>

    <div>
      <p class="dcwr-label dcwr-section__eyebrow" style="margin:0;">{{ product.type | default: 'DCWR T-shirt' }}</p>
      <h1 class="dcwr-product__title">{{ product.title }}</h1>
      <p class="dcwr-product__price" data-dcwr-price>{{ product.selected_or_first_available_variant.price | money }}</p>

      <div class="dcwr-product__desc">{{ product.description }}</div>

      {% form 'product', product, id: 'dcwr-product-form' %}
        <input type="hidden" name="id" data-dcwr-variant-id value="{{ product.selected_or_first_available_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="dcwr-option" data-dcwr-option-index="{{ forloop.index0 }}">
              <p class="dcwr-label dcwr-option__name">{{ option.name }}</p>
              <div class="dcwr-option__values">
                {%- for value in option.values -%}
                  <button type="button" class="dcwr-option__value{% if option.selected_value == value %} is-selected{% endif %}" data-dcwr-option-value="{{ value | escape }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <button type="submit" class="dcwr-button dcwr-product__submit" data-dcwr-submit {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}
        </button>
        <p class="dcwr-product__note">{{ section.settings.note }}</p>
      {% endform %}

      {% render 'dcwr-product-content', product: product %}
    </div>
  </div>
</section>

<script type="application/json" data-dcwr-variants>
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "available": {{ variant.available }},
        "price": {{ variant.price | json }},
        "price_formatted": {{ variant.price | money | json }},
        "options": {{ variant.options | json }},
        "image": {% if variant.image %}{{ variant.image | image_url: width: 1400 | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<script>
  (function () {
    var form = document.getElementById('dcwr-product-form');
    if (!form) return;
    var dataEl = document.querySelector('[data-dcwr-variants]');
    var variants = [];
    try { variants = JSON.parse(dataEl.textContent); } catch (e) { return; }

    var idInput = form.querySelector('[data-dcwr-variant-id]');
    var submit = form.querySelector('[data-dcwr-submit]');
    var priceEl = document.querySelector('[data-dcwr-price]');
    var mainImg = document.querySelector('[data-dcwr-gallery-main] img');
    var groups = Array.prototype.slice.call(form.querySelectorAll('[data-dcwr-option-index]'));

    function selection() {
      return groups.map(function (group) {
        var active = group.querySelector('.is-selected');
        return active ? active.getAttribute('data-dcwr-option-value') : null;
      });
    }

    function matchVariant(values) {
      return variants.find(function (variant) {
        return values.every(function (value, index) {
          return value === null || variant.options[index] === value;
        });
      });
    }

    function refresh() {
      var values = selection();

      groups.forEach(function (group, groupIndex) {
        group.querySelectorAll('[data-dcwr-option-value]').forEach(function (button) {
          var probe = values.slice();
          probe[groupIndex] = button.getAttribute('data-dcwr-option-value');
          var found = variants.find(function (variant) {
            return probe.every(function (value, index) {
              return value === null || variant.options[index] === value;
            });
          });
          button.classList.toggle('is-unavailable', !found || !found.available);
        });
      });

      var variant = matchVariant(values);
      if (!variant) {
        submit.setAttribute('disabled', 'disabled');
        submit.textContent = 'Unavailable';
        return;
      }
      idInput.value = variant.id;
      if (priceEl) priceEl.textContent = variant.price_formatted;
      if (variant.image && mainImg) mainImg.src = variant.image;
      if (variant.available) {
        submit.removeAttribute('disabled');
        submit.textContent = 'Add to cart';
      } else {
        submit.setAttribute('disabled', 'disabled');
        submit.textContent = 'Sold out';
      }
    }

    groups.forEach(function (group) {
      group.addEventListener('click', function (event) {
        var button = event.target.closest('[data-dcwr-option-value]');
        if (!button) return;
        group.querySelectorAll('[data-dcwr-option-value]').forEach(function (other) {
          other.classList.remove('is-selected');
        });
        button.classList.add('is-selected');
        refresh();
      });
    });

    document.querySelectorAll('[data-dcwr-thumb]').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        document.querySelectorAll('[data-dcwr-thumb]').forEach(function (other) {
          other.classList.remove('is-active');
        });
        thumb.classList.add('is-active');
        if (mainImg) mainImg.src = thumb.getAttribute('data-full');
      });
    });

    refresh();
  })();
</script>

{% schema %}
{
  "name": "DCWR product",
  "settings": [
    { "type": "textarea", "id": "note", "label": "Note under the button", "default": "Free shipping over €50 · Shipped within 24 hours · 14-day returns" }
  ]
}
{% endschema %}
