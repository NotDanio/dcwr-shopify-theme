{% comment %} DCWR hero — mirrors the website hero. {% endcomment %}
<section class="dcwr-hero">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'dcwr-hero__image', alt: section.settings.image_alt, width: 2400 }}
  {% else %}
    <img class="dcwr-hero__image" src="{{ 'dcwr-hero.jpg' | asset_url }}" alt="{{ section.settings.image_alt }}" width="1264" height="848">
  {% endif %}
  <div class="dcwr-hero__overlay"></div>

  <div class="dcwr-container dcwr-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="dcwr-label" style="margin:0;">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="dcwr-hero__title">{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}
      <p class="dcwr-hero__text">{{ section.settings.text }}</p>
    {% endif %}
    <div class="dcwr-hero__actions">
      {% if section.settings.button_label != blank %}
        <a class="dcwr-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {% endif %}
      {% if section.settings.button2_label != blank %}
        <a class="dcwr-button dcwr-button--onphoto" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DCWR hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (leave empty for the website photo)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Model wearing a DCWR tee" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "DressCleanWalk Ready" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Timeless essentials in heavyweight cotton. Quiet colours, sharp fit, made to wear every day." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "DCWR hero" }]
}
{% endschema %}
