{% comment %}
  DCWR hero — generated by the DGWR website.
{% endcomment %}
{{ 'dcwr-theme.css' | asset_url | stylesheet_tag }}

<section class="dcwr-hero">
  <div class="dcwr-hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', alt: section.settings.image_alt }}
    {% else %}
      <div style="height:60vh;background:var(--dcwr-muted);"></div>
    {% endif %}
    <div class="dcwr-hero__overlay"></div>
  </div>

  <div class="dcwr-hero__content">
    <div class="dcwr-container">
      {% if section.settings.eyebrow != blank %}
        <p class="dcwr-label">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="dcwr-hero__title">{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}
        <p class="dcwr-hero__text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="dcwr-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DCWR hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Model wearing a DCWR T-shirt" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Dress Clean Walk Ready" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "DressCleanWalk Ready" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Heavyweight cotton T-shirts, designed in the Netherlands." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop T-shirts" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "DCWR hero" }]
}
{% endschema %}
