{% comment %} Shopify sync refresh 2026-09-15 16:58 UTC {% endcomment %}
<footer class="dcwr-footer">
  <div class="dcwr-container dcwr-footer__grid">
    <div>
      <div class="dcwr-footer__logo">
        <img src="{{ 'dcwr-wordmark-green.png' | asset_url }}" alt="{{ shop.name }}" width="437" height="65" loading="lazy">
      </div>
      <p class="dcwr-footer__blurb">{{ section.settings.text }}</p>
    </div>

    {%- for block in section.blocks -%}
      <div class="dcwr-footer__col" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title }}</h3>
        <ul>
          {%- for link in linklists[block.settings.menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}

    <div class="dcwr-footer__col">
      <h3>Contact</h3>
      <ul>
        <li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>
        <li><a href="{{ section.settings.instagram }}">Instagram</a></li>
      </ul>
    </div>
  </div>

  <div class="dcwr-footer__bottom">
    <div class="dcwr-container dcwr-footer__bottom-inner">
      <p style="margin:0;">&copy; {{ 'now' | date: '%Y' }} DCWR. All rights reserved.</p>
      <p class="dcwr-footer__sign" style="margin:0;">Dress clean · Walk ready</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "DCWR footer",
  "max_blocks": 3,
  "settings": [
    { "type": "textarea", "id": "text", "label": "Text", "default": "Dress Clean Walk Ready — clean essentials in heavyweight cotton. Designed in the Netherlands." },
    { "type": "text", "id": "email", "label": "Email", "default": "info@dcwr-shop.com" },
    { "type": "url", "id": "instagram", "label": "Instagram URL", "default": "https://instagram.com/dresscleanwalkready" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "presets": [{ "name": "DCWR footer" }]
}
{% endschema %}
