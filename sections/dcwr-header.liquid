<header class="dcwr-header">
  <div class="dcwr-container dcwr-header__inner">
    <a class="dcwr-header__logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
    <nav class="dcwr-header__nav dcwr-label">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "DCWR header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
