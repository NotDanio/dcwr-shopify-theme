<div class="dcwr-container" style="padding:4rem 1.25rem;">
  <h1>{{ product.title }}</h1>
  {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: alt: product.title }}{% endif %}
  <p>{{ product.price | money }}</p>
  <div>{{ product.description }}</div>
  {% form 'product', product %}
    <select name="id">
      {% for variant in product.variants %}
        <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>
      {% endfor %}
    </select>
    <button class="dcwr-button" type="submit">Add to cart</button>
  {% endform %}
</div>
{% schema %}
{ "name": "Product" }
{% endschema %}
