{% comment %}
  DCWR product page — generated by the DCWR website.
{% endcomment %}
<section class="dcwr-grid-section">
  <div class="dcwr-container">
    <h1 class="dcwr-grid-section__title">{{ product.title }}</h1>
    <p class="dcwr-card__price">{{ product.price | money }}</p>
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.title }}
    {% endif %}
    <div>{{ product.description }}</div>
    {% form 'product', product %}
      <select name="id">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>
        {% endfor %}
      </select>
      <button class="dcwr-button" type="submit" {% unless product.available %}disabled{% endunless %}>Add to cart</button>
    {% endform %}
  </div>
</section>
