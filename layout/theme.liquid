<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Italianno&family=Jost:wght@300;400;500;600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap">
    {{ 'dcwr-theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="{% if template.name == 'index' %}dcwr-template-index{% endif %}">
    {% section 'dcwr-announcement' %}
    {% section 'dcwr-header' %}
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
    <footer class="dcwr-footer">
      <div class="dcwr-container dcwr-footer__grid">
        <div>
          <div class="dcwr-footer__logo">
            <img src="{{ 'dcwr-wordmark-green.png' | asset_url }}" alt="{{ shop.name }}" width="437" height="65" loading="lazy">
          </div>
          <p class="dcwr-footer__blurb">Dress Clean Walk Ready — clean essentials in heavyweight cotton. Designed in the Netherlands.</p>
        </div>
        <div class="dcwr-footer__col">
          <h3>Shop</h3>
          <ul>
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Catalog</a></li>
            <li><a href="{{ routes.search_url }}">Search</a></li>
          </ul>
        </div>
        <div class="dcwr-footer__col">
          <h3>Contact</h3>
          <ul>
            <li><a href="mailto:info@dcwr-shop.com">info@dcwr-shop.com</a></li>
            <li><a href="https://instagram.com/dresscleanwalkready">Instagram</a></li>
          </ul>
        </div>
      </div>
      <div class="dcwr-footer__bottom">
        <div class="dcwr-container dcwr-footer__bottom-inner">
          <p style="margin:0;">&copy; {{ 'now' | date: '%Y' }} DCWR. All rights reserved.</p>
          <p class="dcwr-footer__sign" style="margin:0;">Dress clean · Walk ready</p>
        </div>
      </div>
    </footer>
  </body>
</html>
