<div class="dcwr-page">
  <div class="dcwr-container">
    <h1 class="dcwr-page__title">Cart</h1>

    {% if cart.item_count == 0 %}
      <p class="dcwr-rte">Your cart is empty.</p>
      <a class="dcwr-button" style="margin-top:1.5rem;" href="{{ routes.all_products_collection_url }}">Shop the collection</a>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post">
        {%- for item in cart.items -%}
          <div class="dcwr-cart__row">
            <a href="{{ item.url }}">{{ item.image | image_url: width: 200 | image_tag: alt: item.title }}</a>
            <div>
              <p style="margin:0;font-family:var(--dcwr-font-heading);">{{ item.product.title }}</p>
              <p class="dcwr-muted" style="margin:.25rem 0 0;font-size:.8125rem;">{{ item.variant.title }}</p>
              <input class="dcwr-field" style="width:5rem;margin-top:.5rem;" type="number" min="0" name="updates[]" value="{{ item.quantity }}">
            </div>
            <p style="margin:0;font-family:var(--dcwr-font-brand);font-size:1.5rem;">{{ item.final_line_price | money }}</p>
          </div>
        {%- endfor -%}

        <div class="dcwr-cart__total">
          <span class="dcwr-label">Total</span>
          <span style="font-family:var(--dcwr-font-brand);font-size:1.75rem;">{{ cart.total_price | money }}</span>
        </div>

        <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
          <button type="submit" name="update" class="dcwr-button dcwr-button--outline">Update cart</button>
          <button type="submit" name="checkout" class="dcwr-button">Checkout</button>
        </div>
      </form>
    {% endif %}
  </div>
</div>
