<div class="dcwr-container" style="padding:4rem 1.25rem;">
  <h1>Cart</h1>
  {% if cart.item_count == 0 %}
    <p>Your cart is empty.</p>
  {% else %}
    <form action="/cart" method="post">
      {% for item in cart.items %}
        <p>{{ item.product_title }} — {{ item.final_line_price | money }}</p>
      {% endfor %}
      <button class="dcwr-button" type="submit" name="checkout">Checkout</button>
    </form>
  {% endif %}
</div>
