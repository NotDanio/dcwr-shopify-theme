  <div class="dcwr-hero__overlay"></div>
  <div class="dcwr-container dcwr-hero__content">
    <h1 class="dcwr-hero__title">DressCleanWalk Ready</h1>
    <p class="dcwr-hero__text">Timeless essentials in heavyweight cotton. Quiet colours, sharp fit, made to wear every day.</p>
    <div class="dcwr-hero__actions">
      <a class="dcwr-button" href="{{ routes.all_products_collection_url }}">Shop the collection</a>
    </div>
  </div>
</section>
